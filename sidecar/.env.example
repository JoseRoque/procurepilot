# Sidecar local configuration. Copy to .env for local development.
# The sidecar is local-first: none of these are required for the planner,
# shopping list, ledger, or action harness to work.

# Loopback port for the extension bridge. 127.0.0.1 ONLY — the sidecar never
# binds to another interface. Must match the port entered when pairing.
LOCAL_BRIDGE_PORT=43180

# NOTE: LOCAL_BRIDGE_PAIRING_TOKEN is NOT set here. The sidecar generates a
# random per-install token on first run and stores it in its local SQLite
# profile; copy it from Privacy & sync in the sidecar UI when pairing.

# Cloudflare API base for the OPTIONAL, opt-in redacted sync and config-pack
# download. Can also be changed at runtime in Privacy & sync.
VITE_PI_API_BASE=http://localhost:5173

# Ed25519 public key + key id used to verify configuration packs.
# Defaults to the NON-PRODUCTION dev key when unset.
VITE_CONFIG_PACK_PUBLIC_KEY=replace-with-ed25519-public-key-hex
VITE_CONFIG_PACK_KEY_ID=replace-with-key-id
