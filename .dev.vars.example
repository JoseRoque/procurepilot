# Copy this file to .dev.vars for local development. Never commit .dev.vars
# or real secret values — .dev.vars is gitignored.
#
# In production, set these as Worker secrets instead of plaintext vars:
#   npx wrangler secret put ADMIN_API_TOKEN
#   npx wrangler secret put LEAD_HASH_SALT

# Long random bearer token required by /api/admin/* endpoints.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Server-side salt used to hash IP/user-agent fingerprints for rate limiting
# and abuse forensics. Raw IPs are never stored — only this salted hash.
# Generate one with: openssl rand -hex 32
LEAD_HASH_SALT=replace-with-a-long-random-secret

# Optional: override the default rate limit (5 submissions/hour/fingerprint).
# LEAD_RATE_LIMIT_MAX_PER_HOUR=5

# ---------------------------------------------------------------------------
# Purchasing Intelligence (local-first alpha)
# ---------------------------------------------------------------------------

# Ed25519 PUBLIC key clients use to verify signed configuration packs.
# The matching PRIVATE key must never live in this repository. For local
# development the sidecar falls back to the clearly-labeled non-production
# dev key in packages/test-fixtures/src/devKeys.ts.
CONFIG_PACK_PUBLIC_KEY=replace-with-ed25519-public-key-hex
