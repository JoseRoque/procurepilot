# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.output
stats.html
stats-*.json
.wxt
web-ext.config.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The parent repo's root .gitignore has a bare "Icon" rule for the macOS
# custom-folder-icon artifact ("Icon\r"). On case-insensitive filesystems
# (macOS default), that also matches our lowercase public/icon/ directory —
# un-ignore our real extension icons explicitly.
!public/icon/
!public/icon/*
